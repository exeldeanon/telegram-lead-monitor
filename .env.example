# Telegram API credentials (https://my.telegram.org/apps)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Для Bothost можно использовать имена TELEGRAM_API_ID / TELEGRAM_API_HASH
# и SESSION_STRING вместо файла .session.
SESSION_STRING=

# Для нескольких аккаунтов можно передать весь config.example.json одной
# JSON-строкой через CONFIG_JSON; секреты не нужно коммитить в GitHub.
CONFIG_JSON=

# Название сессии Telethon (без .session)
SESSION_NAME=monitor_session

# ID канала/чата, КУДА бот отправляет алерты
# Бот должен быть добавлен в этот чат как участник/админ
TARGET_CHAT_ID=-1001234567890

# Токен бота (@BotFather → /newbot)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Пути к файлам конфигурации
KEYWORDS_FILE=keywords.txt
CHATS_FILE=chats.txt

# TTL дедупликации в секундах (30 мин по умолчанию)
DEDUP_TTL=1800

# RouterAI API key for AI lead classification (optional)
# Get key at https://routerai.ru
# Leave empty to disable AI filtering
ROUTERAI_API_KEY=
ROUTERAI_MODEL=qwen/qwen2.5-7b-instruct

# Полный путь к общей базе пользователей, которым уже показывали лид
REGISTRY_FILE=lead_registry.json

# Шаблон для ручного подтверждения (переменные: {first_name}, {username},
# {trigger}, {chat_title}, {message})
OUTREACH_TEMPLATE=Здравствуйте, {first_name}! Вы писали про «{trigger}». Если вопрос актуален, могу помочь. Если сообщения не нужны, напишите «стоп».

# ID операторов, которым разрешены команды и кнопки, через запятую
OPERATOR_USER_IDS=

# HTTPS URL опубликованного Mini App. Пусто — кнопка Mini App не показывается.
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
WEBAPP_ALLOW_UNAUTH=false

# Bothost сам передаёт PORT. Локально оставьте пустым.
PORT=

